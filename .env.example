# Copy to .env and fill in. Command line flags override these values.
# .env is gitignored: never commit real credentials.

# Data source: yfinance (default, free), mt5, csv or synthetic.
# The dashboard's Settings page can change it; what it saves wins over these two.
XAU_SOURCE=yfinance
# Leave empty for the source default (GC=F on Yahoo, XAUUSD on MT5). On MT5 use the
# exact Market Watch name (some brokers use XAUUSD.m, XAUUSDm, GOLD, ...).
XAU_SYMBOL=

# Where settings and the M1 history are stored. SQLite by default; for PostgreSQL:
#   XAU_DB_URL=postgresql+psycopg://user:pass@host:5432/xau   (uv sync --extra postgres)
XAU_DB_URL=sqlite:///data/xau.db

# MT5 only. Optional when the terminal is already open and logged in.
# The password is only read from here; it is never stored in the database.
# With MT5_PATH set, the bot starts the terminal itself if it is not running.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Max stop distance for order block limit setups (price units; 3.00 on XAUUSD).
XAU_MAX_SL=3.0

# Web dashboard: XAU_SERVE=1 runs it with the scan loop. Keep XAU_HOST=127.0.0.1
# unless the port is firewalled: the dashboard has no login.
XAU_SERVE=1
XAU_HOST=127.0.0.1
XAU_PORT=8000

# Rotating log file (includes every scan table) and JSON lines output.
XAU_LOG_FILE=logs/screener.log
XAU_JSON_OUT=
