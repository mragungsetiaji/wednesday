# Copy to .env and fill in. Command line flags override these values.
# .env is gitignored: never commit real credentials.

# Data source: yfinance (default, free), mt5, csv or synthetic.
# The dashboard's Settings page can change it; what it saves wins over these two.
XAU_SOURCE=yfinance
# Leave empty for the source default (GC=F on Yahoo, XAUUSD on MT5). On MT5 use the
# exact Market Watch name (some brokers use XAUUSD.m, XAUUSDm, GOLD, ...).
XAU_SYMBOL=
# Clock of the bar times, for the quarterly view: UTC, NY+7 (most MT5 gold brokers),
# UTC+3 or a time zone like Europe/London. Empty = NY+7 for MT5, UTC otherwise.
XAU_CLOCK=

# Where settings and the M1 history are stored. SQLite by default; for PostgreSQL:
#   XAU_DB_URL=postgresql+psycopg://user:pass@host:5432/xau   (uv sync --extra postgres)
XAU_DB_URL=sqlite:///data/xau.db

# MT5 only. Optional when the terminal is already open and logged in; all of these
# can be set in the dashboard (Settings > Data source) instead. The password is
# entered there too and kept in Windows Credential Manager, never in the database.
# With MT5_PATH set, the terminal is started once when the feed starts, if it is not running.
MT5_LOGIN=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Max stop distance for order block limit setups (price units; 3.00 on XAUUSD).
XAU_MAX_SL=3.0

# Web dashboard: XAU_SERVE=1 runs it with the scan loop. Keep XAU_HOST=127.0.0.1
# unless the port is firewalled: the dashboard has no login.
XAU_SERVE=1
XAU_HOST=127.0.0.1
XAU_PORT=8000

# Telegram alerts when price trades into an order block.
# 1) Create a bot with @BotFather and paste its token here.
# 2) Message the bot, run `make telegram-chats` and paste the id it prints.
# Which timeframes/order blocks alert is chosen in the dashboard (Settings).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# News brief (Settings > News brief): the key of the provider you pick there.
# Keys are only read from here, never stored in the database. Needs: uv sync --extra llm
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Lab: where trained and imported model files (zips) are kept.
XAU_MODELS_DIR=data/models

# Rotating log file (includes every scan table) and JSON lines output.
XAU_LOG_FILE=logs/screener.log
XAU_JSON_OUT=
