# Copy to .env and fill in. Command line flags override these values.
# .env is gitignored: never commit real credentials.

# Data source: tradingview (the default, nothing to install; see docs/data-sources.md).
# synthetic is random-walk data for development and tests. What Settings saves wins over these.
XAU_SOURCE=tradingview
# TradingView symbol with its exchange prefix; empty = FX:XAUUSD.
XAU_SYMBOL=
# Clock of the bar times, for the quarterly view: UTC (TradingView), NY+7, UTC+3 or a time zone
# like Europe/London. Empty = UTC.
XAU_CLOCK=
# Seconds between live price updates between the minute scans. Empty = 1; 0 = off.
XAU_TICK=

# Where settings and the M1 history are stored. SQLite by default; for PostgreSQL:
#   XAU_DB_URL=postgresql+psycopg://user:pass@host:5432/xau   (uv sync --extra postgres)
XAU_DB_URL=sqlite:///data/xau.db

# Max stop distance for order block limit setups (price units; 3.00 on XAUUSD).
XAU_MAX_SL=3.0

# Web dashboard: XAU_SERVE=1 runs it with the scan loop. On 127.0.0.1 it has no login; any
# other XAU_HOST turns the login on (or --insecure serves it without one, not recommended).
XAU_SERVE=1
XAU_HOST=127.0.0.1
XAU_PORT=8000

# 1 asks for a login on 127.0.0.1 too (the same as --login).
XAU_LOGIN=

# The login's first account, "admin", made on the first start when there is no account yet.
# Without either, the server logs a one-time setup code: open the dashboard, choose Create
# account and enter it. The hash is an argon2id or old scrypt$ hash; once the account exists
# these are ignored, so clear them and change the password with --create-user or in Settings > Login.
XAU_AUTH_PASSWORD=
XAU_AUTH_PASSWORD_HASH=

# Telegram alerts when price trades into an order block. Set the bot token and chat
# id in the dashboard (Settings > Telegram alerts) instead; these are a fallback.
# The token set there is kept in the system credential store, never in the database.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wednesday EE (paid features): the licence server that activates licence keys and
# hands out the plugin, and where a downloaded plugin is unpacked.
WEDNESDAY_LICENCE_SERVER=
WEDNESDAY_PLUGINS_DIR=

# Rotating log file (includes every scan table) and JSON lines output.
XAU_LOG_FILE=logs/screener.log
XAU_JSON_OUT=
