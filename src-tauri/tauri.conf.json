{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wednesday",
  "version": "0.4.1",
  "identifier": "app.wednesday.desktop",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "PolyForm Noncommercial 1.0.0 plus personal trading use",
    "category": "Finance",
    "shortDescription": "Gold charting and Smart Money Concepts levels",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
